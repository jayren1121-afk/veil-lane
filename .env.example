# Copy to .env.local for local dev, or set these in Cloudflare Pages → Settings → Environment variables.
# Backend (Worker) URL. Local default: http://localhost:8787
VITE_WS_URL=https://veil-lane-server.YOUR-SUBDOMAIN.workers.dev
# Google OAuth Web client ID (leave empty to show guest play only)
VITE_GOOGLE_CLIENT_ID=
